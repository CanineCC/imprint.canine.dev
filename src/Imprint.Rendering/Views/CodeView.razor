@namespace Imprint.Rendering
@inherits NodeViewBase<CodeNode>
@* No MarkupString anywhere near this: the text is emitted as CONTENT, so Blazor escapes
   it and a code sample containing "<script>" is a code sample, not a script. The markup is
   written on one line because <pre> preserves whitespace — a prettier template would put a
   newline inside the element and change the published bytes. JSON and YAML keys and
   punctuation come out wrapped in a marking span (CodeMarks); the text inside stays content. *@
<pre class="ip-code" @attributes="NodeAttributes"><code class="@LanguageClass">@Runs</code></pre>

@code {
  private string? LanguageClass =>
    CodeNode.IsValidLanguage(Node.Language) && Node.Language is { Length: > 0 } lang ? $"language-{lang}" : null;

  private RenderFragment Runs => builder =>
  {
    foreach (var run in CodeMarks.Of(Node.Text, Node.Language))
    {
      if (run.Class is null)
      {
        builder.AddContent(0, run.Text);
      }
      else
      {
        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", run.Class);
        builder.AddContent(3, run.Text);
        builder.CloseElement();
      }
    }
  };
}
