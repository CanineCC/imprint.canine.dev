@namespace Imprint.Rendering
@using Microsoft.AspNetCore.Components.Rendering
@inherits NodeViewBase<WidgetNode>
@{
  var descriptor = Ctx.ResolveWidget(Node.Tag);
}
@if (IsEditor)
{
  @* The canvas renders the REAL island when the editor can serve its bundle (all
     shipped widgets are shadow-DOM components, so a hydrated one never mutates the
     light DOM Blazor owns). NodeAttributes on the host keep it selectable. The
     placeholder remains the honest fallback: unknown tag, or no bundle to serve. *@
  if (descriptor is not null && Ctx.ResolveWidgetBundle?.Invoke(descriptor.Tag) is not null)
  {
    RenderIsland(__builder, descriptor, editorAttributes: true);
  }
  else if (descriptor is not null)
  {
    <div class="ip-widget-placeholder" @attributes="NodeAttributes">@descriptor.Name</div>
  }
  else
  {
    <div class="ip-widget-placeholder ip-placeholder-warn" @attributes="NodeAttributes">Unknown widget @Node.Tag</div>
  }
}
else if (descriptor is not null)
{
  RenderIsland(__builder, descriptor);
}
@* Static + unknown tag: nothing. There is no bundle to load, so a dead custom element
   would ship broken markup to every visitor; the editor placeholder is where the
   problem gets surfaced and fixed. *@

@code {
  private void RenderIsland(RenderTreeBuilder builder, WidgetDescriptor descriptor, bool editorAttributes = false)
  {
    // Tag came from the manifest loader, which enforces lower-case-ASCII-with-hyphen —
    // that validation is what makes emitting it as an element name safe.
    builder.OpenElement(0, descriptor.Tag);

    // A marker class so stylesheets can say "a widget" instead of enumerating tags. The hero's
    // two-up layout used to name every card tag in eight selectors; swapping one card to a new
    // tag silently dropped out of all eight and the card fell under the copy. NodeAttributes
    // carries only data-node-id/type, so this can never be clobbered by the editor path.
    builder.AddAttribute(1, "class", "ip-widget");

    // Editor canvas only: the selection contract (data-node-id/type) rides the host
    // element, exactly like every other node's root.
    if (editorAttributes)
    {
      builder.AddMultipleAttributes(6, NodeAttributes);
    }

    // Attribute allowlist: only props the manifest declares cross into markup, so a
    // stale PropBag entry (or a malicious one) never becomes an attribute.
    foreach (var prop in descriptor.Props)
    {
      // Last gate before markup: a prop name that isn't a plain data attribute — an on*
      // event handler or `style` — must NEVER be emitted with an author-controlled value,
      // or it becomes a live event handler / inline style on every visitor's page (stored
      // XSS / CSS injection). Submission validation and the manifest loader already reject
      // these; this re-checks at the one point every widget attribute passes through, so a
      // hand-edited event stream or manifest cannot slip one past. Mirrors SvgPublishGuard.
      if (!WidgetManifest.IsValidPropName(prop.Name))
      {
        continue;
      }

      // A Private prop is server-side data (e.g. the contact-form's inbox addresses):
      // the value stays in the prop bag for the endpoint to read, but never becomes an
      // attribute — in ANY mode, because the editor canvas is HTML too and publishing
      // the address is exactly what the prop exists to avoid.
      if (prop.Private)
      {
        continue;
      }

      if (Node.Props.Get(prop.Name) is { } value)
      {
        builder.AddAttribute(1, prop.Name, value);
      }
    }

    // ★ A TEMPLATED WIDGET NEVER HYDRATES. Its markup is already the content; loading an island
    //   over it would replace real, styled, indexable HTML with a script's idea of the same thing —
    //   which is the iframe this exists to remove.
    if (descriptor.PrerenderTemplate is not { Length: > 0 }
        && Ctx.ResolveWidgetBundle?.Invoke(descriptor.Tag) is { } bundle)
    {
      builder.AddAttribute(2, "data-island", bundle);
    }

    if (descriptor.Eager)
    {
      builder.AddAttribute(3, "data-island-eager", true);
    }

    // aspect-ratio reserves the box before hydration (zero CLS). The manifest is
    // repo-controlled but still data: the character allowlist keeps the inline style
    // a ratio and nothing else.
    if (descriptor.AspectRatio is { Length: > 0 } aspect && aspect.All(c => char.IsAsciiDigit(c) || c is ' ' or '/' or '.'))
    {
      builder.AddAttribute(4, "style", $"aspect-ratio: {aspect}");
    }

    // ★ The publish-time bake, when there is one: real words inside the element, so the published
    //   HTML carries the facts even though a browser paints the island's shadow root instead. The
    //   editor is excluded on purpose — its canvas shows the live island, and a bake there would be
    //   a second copy of the same data sitting under it.
    var baked = editorAttributes ? null : Prerendered(descriptor);
    if (baked is not null)
    {
      builder.AddContent(5, new MarkupString(baked));
    }
    else
    {
      builder.AddContent(5, descriptor.Placeholder);
    }

    // The pre-hydration fallback gets a REAL link when the manifest declares one: a visitor without
    // JavaScript (and a crawler) reaches the live view instead of a dead label. Hydration replaces
    // this light DOM wholesale, so a hydrated visitor never sees it.
    //
    // ★ NOT WHEN THE CONTENT IS ALREADY HERE. The link offers a way to go and see the real thing;
    //   once a bake has rendered the real thing in place, it offers a trip to the framed view this
    //   page exists to have stopped framing — a live "Open the live view →" under a fully rendered
    //   price list, pointing at /embed/pricing.
    if (baked is null && FallbackHref(descriptor) is { } href)
    {
      builder.OpenElement(7, "a");
      builder.AddAttribute(8, "class", "ip-widget-fallback-link");
      builder.AddAttribute(9, "href", href);
      builder.AddContent(10, "Open the live view →");
      builder.CloseElement();
    }

    builder.CloseElement();
  }

  /// <summary>
  /// Resolve the descriptor's fallback-href template against this instance's props. Only DECLARED,
  /// non-private prop values substitute (the same allowlist the attributes pass through), every
  /// token must resolve to a non-empty value, and the result must be absolute https — otherwise no
  /// link renders at all: a dead or author-forged href is worse than none.
  /// </summary>
  private string? FallbackHref(WidgetDescriptor descriptor) =>
    WidgetTemplate.Resolve(descriptor, descriptor.FallbackHref, Node.Props.Get);

  /// <summary>The bake the publisher fetched for THIS instance, found by the URL its
  /// <see cref="WidgetDescriptor.Prerender"/> template resolves to — the same URL the publisher
  /// keyed it by, through the same resolver, so the two cannot drift apart.</summary>
  private string? Prerendered(WidgetDescriptor descriptor) =>
    Ctx.ResolvePrerendered is { } lookup
      && WidgetTemplate.Resolve(descriptor, descriptor.Prerender, Node.Props.Get) is { } url
        ? lookup(WidgetTemplate.BakeKey(url, descriptor.PrerenderTemplate))
        : null;

}
