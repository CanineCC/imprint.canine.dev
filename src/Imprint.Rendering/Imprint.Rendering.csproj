<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Description>The block components: one Razor view per node type, rendered identically by the editor canvas and the static publisher.</Description>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Imprint.Authoring/Imprint.Authoring.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also embedded (same bytes, second transport): the publisher composes
         site.css = ThemeCss.Emit(theme) + ThemeCss.StructuralCss + ThemeCss.MarketingCss
         without touching static-web-asset paths, while the wwwroot copies serve the
         editor canvas. imprint-marketing.css re-keys the canine marketing design system
         onto imprint's own theme tokens + the ip-ap-* / ip-site-header chrome hooks. -->
    <EmbeddedResource Include="wwwroot/styles/imprint-base.css" LogicalName="Imprint.Rendering.styles.imprint-base.css" />
    <EmbeddedResource Include="wwwroot/styles/imprint-marketing.css" LogicalName="Imprint.Rendering.styles.imprint-marketing.css" />
    <EmbeddedResource Include="wwwroot/styles/imprint-print.css" LogicalName="Imprint.Rendering.styles.imprint-print.css" />
    <EmbeddedResource Include="wwwroot/styles/imprint-resource-center.css" LogicalName="Imprint.Rendering.styles.imprint-resource-center.css" />
    <!-- One product site's own rules, appended only to that site's sheet (ThemeCss.SiteCss). -->
    <EmbeddedResource Include="wwwroot/styles/imprint-site-assure.css" LogicalName="Imprint.Rendering.styles.imprint-site-assure.css" />
    <EmbeddedResource Include="wwwroot/styles/imprint-site-assert.css" LogicalName="Imprint.Rendering.styles.imprint-site-assert.css" />
    <!-- The new Assay site, built as "Assay Preview" beside the live "Assay" site, which takes nothing from it. -->
    <EmbeddedResource Include="wwwroot/styles/imprint-site-assay.css" LogicalName="Imprint.Rendering.styles.imprint-site-assay.css" />
    <EmbeddedResource Include="wwwroot/styles/imprint-site-caninecodeanalyzer.css" LogicalName="Imprint.Rendering.styles.imprint-site-caninecodeanalyzer.css" />
    <!-- Self-hosted variable fonts referenced by imprint-marketing.css (@font-face).
         Embedded so the publisher writes them into every site's /fonts/ folder with no
         external CDN request — EU-resident, zero third parties. The wwwroot copies also
         serve the editor canvas. -->
    <EmbeddedResource Include="wwwroot/fonts/schibsted-var.woff2" LogicalName="Imprint.Rendering.fonts.schibsted-var.woff2" />
    <EmbeddedResource Include="wwwroot/fonts/jetbrains-var.woff2" LogicalName="Imprint.Rendering.fonts.jetbrains-var.woff2" />
    <!-- Assure's own face (Figtree, SIL Open Font License 1.1, for headings, numbers and text; the
         Google Fonts Latin variable file, weights 300 to 900), read only under .ip-site-assure.
         Shipped to every site like the others; a face no rule uses is never downloaded. -->
    <EmbeddedResource Include="wwwroot/fonts/figtree-var.woff2" LogicalName="Imprint.Rendering.fonts.figtree-var.woff2" />
    <!-- Assert's label face (Martian Mono, SIL Open Font License 1.1), read only under .ip-site-assert. -->
    <EmbeddedResource Include="wwwroot/fonts/martian-var.woff2" LogicalName="Imprint.Rendering.fonts.martian-var.woff2" />
    <EmbeddedResource Include="wwwroot/fonts/sourceserif4-var.woff2" LogicalName="Imprint.Rendering.fonts.sourceserif4-var.woff2" />
    <EmbeddedResource Include="wwwroot/fonts/sourceserif4-italic-var.woff2" LogicalName="Imprint.Rendering.fonts.sourceserif4-italic-var.woff2" />
    <!-- Assay's faces from its brand kit (SIL Open Font License 1.1, Adobe): Source Serif 4 with its full
         weight and optical-size axes, and Source Code Pro. Written only on the site that names them
         (FontAssets.ForSite). -->
    <EmbeddedResource Include="wwwroot/fonts/sourceserif4-opsz-var.woff2" LogicalName="Imprint.Rendering.fonts.sourceserif4-opsz-var.woff2" />
    <EmbeddedResource Include="wwwroot/fonts/sourcecodepro-var.woff2" LogicalName="Imprint.Rendering.fonts.sourcecodepro-var.woff2" />
    <!-- CCA's faces from its brand kit (SIL Open Font License 1.1, Braille Institute): Atkinson Hyperlegible Next
         and Atkinson Hyperlegible Mono, Latin, weights 200 to 800. Written only on the site that names them
         (FontAssets.ForSite). -->
    <EmbeddedResource Include="wwwroot/fonts/atkinson-next-var.woff2" LogicalName="Imprint.Rendering.fonts.atkinson-next-var.woff2" />
    <EmbeddedResource Include="wwwroot/fonts/atkinson-mono-var.woff2" LogicalName="Imprint.Rendering.fonts.atkinson-mono-var.woff2" />
    <EmbeddedResource Include="wwwroot/brand/canine-badge.svg" LogicalName="Imprint.Rendering.brand.canine-badge.svg" />
    <EmbeddedResource Include="wwwroot/brand/cai-mark.svg" LogicalName="Imprint.Rendering.brand.cai-mark.svg" />
  </ItemGroup>

</Project>
