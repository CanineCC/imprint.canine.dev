<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/Imprint.Rendering/styles/imprint-base.css" />
    <link rel="stylesheet" href="css/editor.css" />
    @* The post editor's pane split, applied to the root BEFORE first paint — the same trick the
       published site uses for an explicit theme choice. The divider's own module cannot do this:
       it is imported after the first render, so restoring there means the panes draw at half and
       then jump. Custom properties inherit, so the container's var() picks this up, and a drag
       still wins by setting the property on the container itself. *@
    <script>
        (() => {
            try {
                const split = localStorage.getItem('imprint-post-split');
                if (split) {
                    document.documentElement.style.setProperty('--post-split', split + '%');
                }
            } catch {
                /* storage disabled: the default half-and-half is a fine answer */
            }
        })();
    </script>
    <link rel="stylesheet" href="@Assets["Imprint.Editor.styles.css"]" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <title>Imprint</title>
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    @* Canvas island hydrator: imports widget modules as island elements appear (Blazor
       re-renders insert them at any time) so widgets run for real in the editor. *@
    <script type="module" src="js/editor-islands.js"></script>
</body>

</html>
