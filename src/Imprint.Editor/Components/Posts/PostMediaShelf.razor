@* The post editor's media view: the library, narrowed to one tag at a time.

   Tags are shown, not hidden behind a handle. Every tile wears its own tags with an × on
   each and a "+ Tag" next to them, because a filing system nobody can see is a filing system
   nobody uses — the first version put them behind a small badge in a tile corner and the
   answer to "how do I tag this?" was "you don't, apparently".

   A tag is nothing but a label an asset carries (there is no tag aggregate, and no registry:
   the tags that EXIST are the tags in use). Two rows say what happens: what new uploads are
   tagged with — pre-filled with the post's own name, so nothing dropped here lands unfiled —
   and which group the shelf is showing. They are deliberately separate: browsing another
   group must not quietly re-file the next drop somewhere the author was only looking. *@
@using Imprint.Authoring.Domain.Assets
@using Imprint.Authoring.Features.Assets.TagAsset
@using Imprint.Authoring.Features.Assets.UntagAsset
@using Imprint.Authoring.Projections
@using Imprint.Editor.Services
@implements IDisposable
@inject AssetLibrary Library
@inject CommandRunner Commands

<div class="post-media" data-testid="post-media">
    <div class="post-media-head">
        <h2>Media</h2>
        <label class="ed-btn ed-btn-primary post-media-upload">
            @(Uploading.Count > 0 ? "Uploading…" : "Upload files")
            <InputFile OnChange="OnFiles" multiple class="ed-visually-hidden"
                       data-testid="post-media-input" aria-label="Upload images" />
        </label>
    </div>

    @{ var tags = Library.Tags(); }
    <div class="post-media-row">
        <label class="post-media-row-label" for="post-upload-tags">Tag new uploads with</label>
        <input id="post-upload-tags" class="ed-input post-tag-input" list="post-tag-options"
               data-testid="post-tag-choose" placeholder="@DefaultTag"
               value="@UploadTags" @oninput="OnUploadTagsInput" />
    </div>
    <p class="post-media-hint">
        Separate several with commas. Leave it alone and everything you upload or drop is filed
        under <strong>@(UploadTagsOrDefault())</strong> — you can add or remove a file's tags below
        whenever you like.
    </p>

    <div class="post-media-row">
        <span class="post-media-row-label">Showing</span>
        <ul class="post-tag-bar" data-testid="post-tag-bar" aria-label="Filter by tag">
            <li>
                <button type="button" class="post-tag @(_scope == Scope.All ? "is-on" : null)"
                        data-testid="post-tag-all" @onclick="() => Select(Scope.All, null)">All (@Library.All().Count)</button>
            </li>
            @foreach (var name in tags)
            {
                var tag = name;
                <li>
                    <button type="button" class="post-tag @(IsShowing(tag) ? "is-on" : null)"
                            data-testid="post-tag" data-tag="@tag"
                            @onclick="() => Select(Scope.Tag, tag)">@tag (@Library.Tagged(tag).Count)</button>
                </li>
            }
            <li>
                <button type="button" class="post-tag @(_scope == Scope.Untagged ? "is-on" : null)"
                        data-testid="post-tag-untagged"
                        @onclick="() => Select(Scope.Untagged, null)">Untagged (@Library.Untagged().Count)</button>
            </li>
        </ul>
    </div>

    @foreach (var name in Uploading)
    {
        <div class="post-media-uploading" role="status">Uploading @name…</div>
    }

    @{ var shelf = Shelf(); }
    @if (shelf.Count == 0 && Uploading.Count == 0)
    {
        <p class="post-media-empty" data-testid="post-media-empty">@EmptyText()</p>
    }
    else
    {
        <ul class="post-media-grid" data-testid="post-media-grid">
            @foreach (var asset in shelf)
            {
                var candidate = asset;
                <li @key="candidate.Id" class="post-media-item">
                    <button type="button" class="post-media-tile" data-testid="post-media-tile"
                            data-asset="@candidate.Id.Compact" title="Insert @candidate.Name into the post"
                            @onclick="() => OnPick.InvokeAsync(candidate)">
                        <img class="post-media-thumb" src="@ThumbUrl(candidate)" alt="" loading="lazy" />
                        <span class="post-media-name">@candidate.Name</span>
                        @if (candidate.Status != AssetStatus.Ready)
                        {
                            <span class="post-media-badge">@candidate.Status</span>
                        }
                    </button>

                    @* The tags live on the tile, in the open. Removing one is the × that is
                       already on screen; adding one is a button that says what it does. *@
                    <ul class="post-media-tags" aria-label="Tags on @candidate.Name">
                        @foreach (var name in candidate.Tags)
                        {
                            var tag = name;
                            <li class="post-tag-chip" data-tag="@tag">
                                <span>@tag</span>
                                <button type="button" data-testid="post-tag-remove"
                                        data-asset="@candidate.Id.Compact" data-tag="@tag"
                                        title="Remove the tag '@tag' from @candidate.Name"
                                        aria-label="Remove the tag @tag from @candidate.Name"
                                        @onclick="() => Untag(candidate, tag)">×</button>
                            </li>
                        }
                        <li>
                            <button type="button" class="post-tag-add-open" data-testid="post-tag-add-open"
                                    data-asset="@candidate.Id.Compact"
                                    aria-expanded="@(_addFor == candidate.Id ? "true" : "false")"
                                    title="Add a tag to @candidate.Name"
                                    @onclick="() => ToggleAdd(candidate.Id)">+ Tag</button>
                        </li>
                    </ul>

                    @if (_addFor == candidate.Id)
                    {
                        <div class="post-tag-add">
                            <input class="ed-input post-tag-input" list="post-tag-options"
                                   placeholder="Tag name…" data-testid="post-tag-add"
                                   aria-label="New tag for @candidate.Name" autofocus
                                   value="@_addDraft"
                                   @oninput="args => _addDraft = args.Value?.ToString() ?? string.Empty"
                                   @onkeydown="args => OnAddKey(args, candidate)" />
                            <button type="button" class="ed-btn ed-btn-ghost" data-testid="post-tag-add-go"
                                    @onclick="() => AddDraft(candidate)">Add</button>
                        </div>
                    }
                </li>
            }
        </ul>
    }

    <datalist id="post-tag-options">
        @foreach (var name in tags)
        {
            <option value="@name"></option>
        }
    </datalist>
</div>

@code {
    /// <summary>Names of files currently streaming up, owned by the editor that does the upload.</summary>
    [Parameter] public IReadOnlyList<string> Uploading { get; set; } = [];

    /// <summary>The post's own tag — what an upload is filed under when the author types nothing.</summary>
    [Parameter] public string DefaultTag { get; set; } = "";

    /// <summary>What new uploads are tagged with, comma-separated. Owned by the editor, which does the upload.</summary>
    [Parameter] public string UploadTags { get; set; } = "";

    [Parameter] public EventCallback<string> UploadTagsChanged { get; set; }

    /// <summary>A tile was clicked: reference this asset in the post.</summary>
    [Parameter] public EventCallback<Asset> OnPick { get; set; }

    /// <summary>Files chosen through the shelf's own button; the editor uploads them.</summary>
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnFiles { get; set; }

    private enum Scope { All, Untagged, Tag }

    private Scope _scope = Scope.All;
    private string? _showing;
    private string _addDraft = "";
    private AssetId? _addFor;

    protected override void OnInitialized()
    {
        // Open on this post's own media when there is some: "first choose a tag" is a step the
        // shelf can take on the author's behalf, because it knows which post they are in.
        if (DefaultTag is { Length: > 0 } && Library.Tagged(DefaultTag).Count > 0)
        {
            _scope = Scope.Tag;
            _showing = DefaultTag;
        }

        Library.Changed += Refresh;
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    // ----------------------------------------------------------- upload tagging

    private Task OnUploadTagsInput(ChangeEventArgs args) =>
        UploadTagsChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    // An empty field means "the usual", not "no tag at all": the placeholder and the line under
    // it both name the post's own tag, and the upload path applies the same fallback.
    private string UploadTagsOrDefault() =>
        AssetTag.Normalize(UploadTags) is { Length: > 0 } typed ? typed : DefaultTag;

    // --------------------------------------------------------------- filtering

    private IReadOnlyList<Asset> Shelf() => _scope switch
    {
        Scope.Untagged => Library.Untagged(),
        Scope.Tag when _showing is { Length: > 0 } tag => Library.Tagged(tag),
        _ => Library.All(),
    };

    private bool IsShowing(string tag) =>
        _scope == Scope.Tag && _showing is { } showing && AssetTag.Comparer.Equals(showing, tag);

    private string EmptyText() => _scope switch
    {
        Scope.Untagged => "Every file carries a tag.",
        Scope.Tag when _showing is { Length: > 0 } tag => $"Nothing tagged '{tag}' yet.",
        _ => "Nothing uploaded yet. Drop an image on either pane and it lands in the post.",
    };

    private void Select(Scope scope, string? tag)
    {
        _scope = scope;
        _showing = tag;
        _addFor = null;
    }

    // ------------------------------------------------------------------ tagging

    // Run without an inverse, like every other command the post editor sends. The undo stack is
    // per circuit and its UI is the PAGE editor's toolbar — an undoable tag would survive the
    // navigation and turn a later Ctrl+Z on some page into "untag a file you cannot see". The
    // remedy for a mis-tag is right here anyway: the chip, and the × on it.
    private Task Tag(Asset asset, string tag) => Commands.Run(new TagAsset(asset.Id, tag));

    private Task Untag(Asset asset, string tag) => Commands.Run(new UntagAsset(asset.Id, tag));

    private void ToggleAdd(AssetId id)
    {
        _addFor = _addFor == id ? null : id;
        _addDraft = "";
    }

    private async Task AddDraft(Asset asset)
    {
        var tag = AssetTag.Normalize(_addDraft);
        if (tag.Length == 0)
        {
            return;
        }

        _addDraft = "";
        _addFor = null;
        await Tag(asset, tag);
    }

    private async Task OnAddKey(KeyboardEventArgs args, Asset asset)
    {
        if (args.Key == "Enter")
        {
            await AddDraft(asset);
        }
        else if (args.Key == "Escape")
        {
            _addDraft = "";
            _addFor = null;
        }
    }

    // ------------------------------------------------------------------ display

    // The real picture where there is one: a vector's sanitized rendition draws itself, and
    // a raster's smallest variant is already the right size for a tile.
    private static string ThumbUrl(Asset asset) => asset switch
    {
        { Kind: AssetKind.Image, Variants.Count: > 0 } => $"/media/{asset.Variants[0].StorageKey}",
        { Kind: AssetKind.Vector, DerivedStorageKey: { } key } => $"/media/{key}",
        _ => $"/media/{asset.OriginalStorageKey}",
    };

    public void Dispose() => Library.Changed -= Refresh;
}
