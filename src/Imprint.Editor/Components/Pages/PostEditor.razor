@page "/posts/{PostIdValue}"
@using Imprint.Authoring.Domain
@using Imprint.Authoring.Domain.Assets
@using Imprint.Authoring.Domain.Posts
@using Imprint.Authoring.Domain.Sites
@using Imprint.Authoring.Features.Posts.ApprovePostReview
@using Imprint.Authoring.Features.Posts.ChangePostBody
@using Imprint.Authoring.Features.Posts.RequestPostChanges
@using Imprint.Authoring.Features.Posts.SchedulePost
@using Imprint.Authoring.Features.Posts.SubmitPostForReview
@using Imprint.Authoring.Features.Posts.PublishPost
@using Imprint.Authoring.Features.Posts.UnpublishPost
@using Imprint.Authoring.Markdown
@using Imprint.Authoring.Projections
@using Imprint.Editor.Auth
@using Imprint.Editor.Components.Posts
@using Imprint.Editor.Services
@using Imprint.EventSourcing
@using Imprint.Publishing
@using Imprint.Rendering
@implements IDisposable
@implements IAsyncDisposable
@inject IAggregateStore Store
@inject PostList Posts
@inject SiteOverview Sites
@inject SiteAccess Access
@inject CommandRunner Commands
@inject EditorRenderContextFactory ContextFactory
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject IJSRuntime Js

<PageTitle>@(_titleText is { Length: > 0 } t ? $"{t} · Imprint" : "Post · Imprint")</PageTitle>

@if (_post is null)
{
    <main class="dash"><p class="dash-sub">Loading…</p></main>
}
else
{
    <main class="post-editor">
        <header class="post-editor-head">
            <Breadcrumbs Trail="@Trail" />
            <h1 class="post-editor-title" data-testid="post-title">@_titleText</h1>
            <span class="post-status post-status-@_status.ToString().ToLowerInvariant()"
                  data-testid="post-status">@Label(_status)</span>
            <span class="post-editor-actions">
                @* The same escape hatch a page has: the real thing, in a real browser tab, with
                   the site's chrome and stylesheet around it — and for a post it works BEFORE
                   publishing, because the preview plane renders drafts from current markdown.
                   The pane on the right shows the nodes; only this shows the page. *@
                <a class="ed-btn ed-btn-ghost" href="@PreviewHref" target="_blank" rel="noopener"
                   data-testid="post-preview-link" title="Open this post in a new tab, as a page">Preview&nbsp;↗</a>

                @* One date field, shared by author and reviewer: the author proposes with it, the
                   reviewer overrules with it, and an empty box is a real answer ("to be decided")
                   rather than "now". Wall-clock time in the editorial zone — an author schedules
                   a post for nine in the morning where they live, not nine UTC. *@
                <label class="post-when">
                    <span class="post-when-label">Go live</span>
                    <input type="datetime-local" class="ed-input post-when-input" data-testid="post-publish-at"
                           value="@_publishAtLocal" @onchange="OnPublishAtChanged"
                           disabled="@(_status == PostStatus.Published)"
                           title="@($"Wall-clock time in {EditorialTime.Zone.Id}. Leave empty for 'to be decided'.")" />
                    @if (_publishAtLocal.Length > 0 && _status != PostStatus.Published)
                    {
                        <button type="button" class="ed-btn ed-btn-ghost post-when-clear" data-testid="post-publish-at-clear"
                                title="Clear the date — the post waits until someone sets one"
                                @onclick="() => SetPublishAt(null)">TBD</button>
                    }
                </label>

                @* Which button you get is decided by where the POST stands, not by who you are —
                   the two only diverge while the reviewer holds it. Offering Publish on a site
                   that publishes through review would be offering something the command refuses,
                   which is how a workflow teaches people to distrust its buttons. *@
                @if (_status == PostStatus.InReview && _isReviewer)
                {
                    @* Approve takes whatever is in the date box, which is how "change the date
                       to your liking" happens without a second control. *@
                    <button type="button" class="ed-btn ed-btn-primary" data-testid="post-approve"
                            title="Approve the content and the date" @onclick="Approve">Approve</button>
                    <button type="button" class="ed-btn" data-testid="post-request-changes"
                            @onclick="() => _askingChanges = !_askingChanges">Send back…</button>
                }
                else if (!CanEdit)
                {
                    @* A review pass carries nothing else: approving or sending back is the whole
                       of this visitor's authority, and every control below writes to the post. *@
                }
                else if (_status == PostStatus.Published)
                {
                    <button type="button" class="ed-btn" data-testid="post-unpublish"
                            @onclick="Unpublish">Unpublish</button>
                }
                else if (_status == PostStatus.InReview)
                {
                    <button type="button" class="ed-btn" data-testid="post-submit-review" disabled
                            title="@($"{Reviewer} has it")">With @Reviewer</button>
                }
                else if (Reviewer is { } reviewer && _status is not (PostStatus.Approved or PostStatus.Scheduled))
                {
                    <button type="button" class="ed-btn ed-btn-primary" data-testid="post-submit-review"
                            title="@($"Send to {reviewer} for public relations review")"
                            @onclick="SubmitForReview">Send for review</button>
                }
                else
                {
                    <button type="button" class="ed-btn ed-btn-primary" data-testid="post-publish"
                            title="@(IsFuture ? "Publish now, ignoring the scheduled date" : "Publish this post")"
                            @onclick="Publish">@(IsFuture ? "Publish now" : "Publish")</button>
                }
            </span>
        </header>

        @if (StatusLine is { Length: > 0 } line)
        {
            <p class="post-review-line" data-testid="post-review-line">@line</p>
        }

        @if (_askingChanges)
        {
            <div class="post-sendback" data-testid="post-sendback">
                <label for="post-sendback-reason">What needs changing?</label>
                <textarea id="post-sendback-reason" class="ed-input" rows="2" data-testid="post-sendback-reason"
                          @bind="_changesReason" @bind:event="oninput"
                          placeholder="The author sees this — say what to fix."></textarea>
                <button type="button" class="ed-btn ed-btn-primary" data-testid="post-sendback-send"
                        disabled="@(_changesReason.Trim().Length == 0)" @onclick="RequestChanges">Send back</button>
                <button type="button" class="ed-btn ed-btn-ghost" @onclick="() => _askingChanges = false">Cancel</button>
            </div>
        }

        @* The two panes are the whole point: the same text, and what it will actually become.
           The preview is rendered SERVER-SIDE through MarkdownToNodes and the ordinary node
           views — the same path the publisher takes — so it cannot drift from the published
           page the way a client-side markdown library would.

           The markdown pane is now nothing but markdown. The media shelf used to sit under
           it and, once a few files were on it, left a couple of visible lines of the thing
           the author came here to write. Media is a WAY OF LOOKING at the right-hand pane —
           the same real estate the preview occupies, which is the pane you can afford to
           stop looking at while you pick a picture. *@
        <div class="post-panes" @ref="_panes">
            <section class="post-pane post-pane-source" aria-label="Markdown" @ref="_sourcePane">
                <textarea class="post-source" data-testid="post-body" spellcheck="true" @ref="_sourceBox"
                          @bind="Body" @bind:event="oninput" readonly="@(!CanEdit)"
                          placeholder="# Your post&#10;&#10;Write in markdown."></textarea>

                @* file-drop.js hands a drop to the first file input inside the element it was
                   wired to, and the shelf's input now lives in the other pane — so dropping on
                   the text needs an input of its own here, or the gesture the hint promises
                   would quietly do nothing. *@
                @if (CanEdit)
                {
                    <InputFile OnChange="OnFiles" multiple class="ed-visually-hidden"
                               data-testid="post-source-drop" aria-label="Upload images into the post" />
                }
            </section>

            @* The divider. A real separator control rather than a decorative bar: it drags with a
               pointer, moves with the arrow keys, snaps back to even on a double-click, and
               remembers where it was left. *@
            <div class="post-split" data-split-handle role="separator" aria-orientation="vertical"
                 tabindex="0" aria-label="Resize the markdown and preview panes"
                 aria-valuemin="15" aria-valuemax="85" aria-valuenow="50"
                 title="Drag to resize · double-click to even them up" data-testid="post-split"></div>

            <section class="post-pane post-pane-side" aria-label="Preview and media" @ref="_sidePane">
                @* The media half of this pane is an editing tool, so a review pass gets no switch
                   to reach it — one pane, showing the post. *@
                @if (CanEdit)
                {
                    <div class="post-views" role="tablist" aria-label="Right pane">
                        <button type="button" role="tab" class="post-view @(_view == SideView.Preview ? "is-on" : null)"
                                aria-selected="@(_view == SideView.Preview ? "true" : "false")"
                                data-testid="post-view-preview"
                                @onclick="() => _view = SideView.Preview">Preview</button>
                        <button type="button" role="tab" class="post-view @(_view == SideView.Media ? "is-on" : null)"
                                aria-selected="@(_view == SideView.Media ? "true" : "false")"
                                data-testid="post-view-media"
                                @onclick="() => _view = SideView.Media">Media</button>
                    </div>

                    @* The pane's own drop input, outside the view switch: dropping a file while the
                       preview is showing must still upload — the author aimed at the window, not at
                       a tab. It comes first in the DOM, so it is the one file-drop.js finds. *@
                    <InputFile OnChange="OnFiles" multiple class="ed-visually-hidden"
                               data-testid="post-side-drop" aria-label="Upload images into the post" />
                }

                @* The scroller is this wrapper, never the preview itself: the preview carries
                   `inert`, and inert disables hit-testing for its whole subtree — so a wheel over
                   an inert scroll container finds nothing to scroll and the author is stuck at the
                   top of their own post. The page editor has always done it this way
                   (.ed-canvas-scroll around .ed-canvas); this pane simply forgot to. *@
                <div class="post-view-body" data-testid="post-view-body">
                @if (_view == SideView.Preview || !CanEdit)
                {
                    @* The canvas paints itself from the PUBLISHED site's tokens (--ip-background and
                       friends), which only exist where something emits them — the page editor does it
                       in Canvas.razor. Without this the preview fell back to a bare white box and text
                       whose colour token resolved to nothing: unreadable, and nothing like the page it
                       claims to be a preview of. Scoped to .post-preview, which is the same element
                       carrying .ed-canvas, so its own declarations can see the variables. *@
                    @if (Sites.Get(_siteId) is { } previewSite)
                    {
                        <style>@((MarkupString)ThemeCss.EmitScoped(previewSite.Theme, ".post-preview"))</style>
                    }
                    <div class="ed-canvas post-preview" data-testid="post-preview" inert>
                        <CascadingValue Value="PreviewContext">
                            <PageView Roots="_preview" />
                        </CascadingValue>
                    </div>
                }
                else
                {
                    @* DefaultTag is a string parameter, so it needs @ — without it Razor passes
                       the literal text "DefaultTag" and every upload is filed under that. *@
                    <PostMediaShelf Uploading="_uploading" DefaultTag="@DefaultTag"
                                    @bind-UploadTags="_uploadTags"
                                    OnPick="InsertAsset" OnFiles="OnFiles" />
                }
                </div>
            </section>
        </div>

        @if (_problems.Count > 0)
        {
            @* Shown continuously, not only on a failed publish: the author finds out at the
               line they are typing, rather than at the moment they wanted to be finished. *@
            <ul class="post-problems" aria-label="Problems" data-testid="post-problems">
                @foreach (var problem in _problems)
                {
                    <li><strong>Line @problem.Line</strong> — @problem.Message</li>
                }
            </ul>
        }
    </main>
}

@code {
    [Parameter] public string PostIdValue { get; set; } = "";

    private PostId _id;
    private SiteId _siteId;
    private Post? _post;
    private Locale _locale = new("en");
    private string _titleText = "";
    private string _slug = "";
    private PostStatus _status = PostStatus.Draft;

    private string _body = "";
    private NodeList _preview = NodeList.Empty;
    private IReadOnlyList<MarkdownProblem> _problems = [];

    private RenderContext PreviewContext => ContextFactory.For(_locale, _locale);

    // ------------------------------------------------------------- review & date

    /// <summary>The date box's value, wall-clock in the editorial zone; empty means "to be decided".</summary>
    private string _publishAtLocal = "";

    private DateTimeOffset? _publishAt;
    private PostReview _review;
    private string? _reviewNote;
    private bool _isReviewer;

    /// <summary>
    /// What this visitor may do here. It gates every command this page can dispatch, because the
    /// dispatcher itself is not access-checked — on this screen the UI IS the boundary, so a
    /// control that must not be used is not rendered rather than merely disabled.
    /// </summary>
    /// Starts closed and is opened by the load, which sets it before <c>_post</c> — so the
    /// only state that renders any control is one that has been through PassForAsync.
    private PostPass _pass = PostPass.None;

    /// <summary>Whether the words may be changed. False for a reviewer, who clears them as written.</summary>
    private bool CanEdit => _pass is PostPass.Edit;

    private bool _askingChanges;
    private string _changesReason = "";

    /// <summary>The site's reviewer, if it has one — the whole review flow hangs off this being non-null.</summary>
    private string? Reviewer =>
        Sites.Get(_siteId) is { ReviewerEmail: { Length: > 0 } email } site
            ? site.ReviewerName is { Length: > 0 } name ? name : email
            : null;

    private bool IsFuture => _publishAt is { } at && at > DateTimeOffset.UtcNow;

    /// <summary>
    /// The one sentence that says what is actually going on — who is waiting for whom, or when
    /// this goes out. A status chip has room for one word, and "Approved" alone does not tell an
    /// author whether anything will ever happen next.
    /// </summary>
    private string? StatusLine => _status switch
    {
        PostStatus.InReview when Reviewer is { } who =>
            $"With {who} for review{Scheduled()}. Nothing publishes until they approve it.",
        PostStatus.ChangesRequested =>
            $"Sent back{(Reviewer is { } who ? $" by {who}" : "")}: {_reviewNote}",
        PostStatus.Approved =>
            "Approved, with no date yet — it stays here until someone sets one.",
        PostStatus.Scheduled =>
            $"Publishes by itself{Scheduled()}.",
        PostStatus.Published when _publishAt is not null =>
            $"Live{Scheduled(" since ")}.",
        _ => null,
    };

    private string Scheduled(string prefix = " on ") =>
        _publishAt is { } at ? $"{prefix}{EditorialTime.ForAuthor(at)} ({EditorialTime.Zone.Id})" : "";

    private async Task OnPublishAtChanged(ChangeEventArgs args)
    {
        var text = args.Value?.ToString() ?? "";
        // The browser hands back "yyyy-MM-ddTHH:mm" in the user's own reading of local time; it is
        // interpreted in the editorial zone, which is the zone the label promises.
        DateTimeOffset? at = DateTime.TryParse(text, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var local)
            ? EditorialTime.FromLocal(local)
            : null;

        await SetPublishAt(at);
    }

    private async Task SetPublishAt(DateTimeOffset? at)
    {
        if (await Commands.Run(new SchedulePost(_id, at)))
        {
            ApplyPost(await Store.LoadOrDefault<Post>(_id.Stream) ?? _post!);
        }
    }

    private async Task SubmitForReview()
    {
        if (!CanEdit)
        {
            return;
        }

        // The date in the box travels with the submission as the author's proposal — the reviewer
        // sees it in the mail and can change it before approving.
        // The reviewer must read what is on screen, not what the autosave last managed.
        await FlushBody();
        if (await Commands.Run(new SubmitPostForReview(_id, _locale.Value, _publishAt, null)))
        {
            Toasts.Show($"Sent to {Reviewer} for review.");
            ApplyPost(await Store.LoadOrDefault<Post>(_id.Stream) ?? _post!);
        }
    }

    private async Task Approve()
    {
        if (await Commands.Run(new ApprovePostReview(_id, _publishAt)))
        {
            Toasts.Show(_publishAt is { } at
                ? $"Approved — it goes live {EditorialTime.ForAuthor(at)}."
                : "Approved. It waits until a date is set.");
            ApplyPost(await Store.LoadOrDefault<Post>(_id.Stream) ?? _post!);
        }
    }

    private async Task RequestChanges()
    {
        if (await Commands.Run(new RequestPostChanges(_id, _changesReason)))
        {
            _askingChanges = false;
            _changesReason = "";
            ApplyPost(await Store.LoadOrDefault<Post>(_id.Stream) ?? _post!);
        }
    }

    /// <summary>
    /// This post on the /preview plane, which renders the site the way it will be published and
    /// (uniquely) includes drafts. Addressed by the site's compact id, which never changes, and
    /// by the path the PUBLISHER will write — asked of BlogPaths rather than assumed here, which
    /// is how this link came to 404: it hard-coded /blog/, and a blog site's posts sit at its root.
    /// </summary>
    private string PreviewHref =>
        $"/preview/{_siteId.Compact}{BlogPaths.PostPath(Sites.Get(_siteId)?.Kind ?? SiteKind.Site, _slug)}";

    // Sites / <blog> / Posts / <this post>. The post editor used to offer "← Posts" and nothing
    // else: from here the dashboard was unreachable except by editing the URL.
    private IReadOnlyList<Breadcrumbs.Crumb> Trail =>
        // A review pass reaches exactly one post, so the trail names where they are and offers no
        // links: every rung above this one redirects a reviewer straight back out.
        !CanEdit
            ? [new Breadcrumbs.Crumb(Sites.Get(_siteId)?.Name ?? "Posts"), new Breadcrumbs.Crumb(_titleText)]
            : Sites.Get(_siteId) is { } site
                ?
                [
                    Breadcrumbs.Sites,
                    Breadcrumbs.Of(site),
                    new Breadcrumbs.Crumb("Posts", $"/site/{_siteId.Compact}/posts"),
                    new Breadcrumbs.Crumb(_titleText),
                ]
                : [Breadcrumbs.Sites, new Breadcrumbs.Crumb("Posts", $"/site/{_siteId.Compact}/posts")];

    // ----------------------------------------------------------------- media

    private const long MaxUploadBytes = 500L * 1024 * 1024;

    private enum SideView { Preview, Media }

    private SideView _view = SideView.Preview;

    private ElementReference _panes;
    private ElementReference _sourcePane;
    private ElementReference _sidePane;
    private ElementReference _sourceBox;
    private IJSObjectReference? _dropModule;
    private IJSObjectReference? _splitModule;
    private IJSObjectReference? _caretModule;
    private readonly List<string> _uploading = [];

    /// <summary>
    /// What new uploads are tagged with — comma-separated, editable, and pre-filled with
    /// <see cref="DefaultTag"/>. It is *not* the shelf's filter: browsing another group must
    /// not quietly re-file the next drop somewhere the author was only looking.
    /// </summary>
    private string _uploadTags = "";

    /// <summary>
    /// The post's own name as a tag. "Every upload carries at least one tag" is a rule the
    /// product keeps rather than a form the author fills: a file dropped into a post belongs
    /// to that post, and nothing uploaded here can land in the library unfiled. The author can
    /// still type other tags before dropping, and take this one off the file afterwards.
    /// </summary>
    private string DefaultTag => TagFrom(_titleText);

    private static string TagFrom(string title)
    {
        var tag = AssetTag.Normalize(title);
        return tag.Length <= AssetTag.MaxLength ? tag : tag[..AssetTag.MaxLength].TrimEnd();
    }

    /// <summary>
    /// The tags an upload gets: what the author typed, or the post's own tag when they typed
    /// nothing. Duplicates and stray commas are the author's shorthand, not an error.
    /// </summary>
    private IReadOnlyList<string> UploadTags()
    {
        var typed = _uploadTags
            .Split(',')
            .Select(AssetTag.Normalize)
            .Where(tag => tag.Length > 0)
            .Distinct(AssetTag.Comparer)
            .ToList();

        return typed.Count > 0 ? typed : DefaultTag is { Length: > 0 } fallback ? [fallback] : [];
    }

    private async Task OnFiles(InputFileChangeEventArgs args)
    {
        if (!CanEdit)
        {
            return;
        }

        foreach (var file in args.GetMultipleFiles(50))
        {
            if (file.Size > MaxUploadBytes)
            {
                Toasts.Error($"'{file.Name}' is larger than the 500 MB upload limit.");
                continue;
            }

            if (file.Size == 0)
            {
                Toasts.Error($"'{file.Name}' is empty, so there is nothing to upload.");
                continue;
            }

            var assetId = AssetId.New();
            _uploading.Add(file.Name);
            StateHasChanged();
            try
            {
                // Same in-process, read-once stream contract the assets panel uses.
                await using var content = file.OpenReadStream(maxAllowedSize: MaxUploadBytes);
                if (await Commands.Run(new Authoring.Features.Assets.UploadAsset.UploadAsset(
                        assetId, file.Name, ContentTypeOf(file), file.Size, content)))
                {
                    // Filed as it lands, which is the only moment the author's intent is known
                    // without asking. Separate commands rather than a field on the upload — the
                    // upload slice streams bytes and knows nothing of the library's filing.
                    foreach (var tag in UploadTags())
                    {
                        await Commands.Run(new Authoring.Features.Assets.TagAsset.TagAsset(assetId, tag));
                    }

                    // Referenced immediately, while it is still processing: the reference is
                    // the id, and the id is final the moment the upload lands. Waiting for
                    // Ready would mean dropping a file and watching nothing happen.
                    await InsertReference(Path.GetFileNameWithoutExtension(file.Name), assetId);
                }
            }
            catch (Exception)
            {
                Toasts.Error($"Reading '{file.Name}' from the browser failed — please try again.");
            }
            finally
            {
                _uploading.Remove(file.Name);
                StateHasChanged();
            }
        }
    }

    private static string ContentTypeOf(IBrowserFile file) =>
        string.IsNullOrWhiteSpace(file.ContentType) || !file.ContentType.Contains('/')
            ? "application/octet-stream"
            : file.ContentType;

    private Task InsertAsset(Asset asset) => InsertReference(asset.Name, asset.Id);

    /// <summary>
    /// Splices an image reference into the body at the caret. The splice happens HERE, on the
    /// bound value, rather than in JS writing .value — Blazor would keep the old string and
    /// throw the insert away on the next render.
    /// </summary>
    private async Task InsertReference(string alt, AssetId assetId)
    {
        var caret = _caretModule is null ? _body.Length : await _caretModule.InvokeAsync<int>("caretOf", _sourceBox);
        caret = Math.Clamp(caret, 0, _body.Length);

        // An image is only an image node when it is alone in its paragraph (TryImageOnly), so
        // the blank lines are not cosmetic — without them the reference becomes body text in
        // the surrounding paragraph and publishes as literal characters.
        var before = _body[..caret].TrimEnd();
        var after = _body[caret..].TrimStart();
        var reference = $"![{alt}](media:{assetId.Compact})";
        var text = (before.Length > 0 ? before + "\n\n" : string.Empty)
                   + reference
                   + (after.Length > 0 ? "\n\n" + after : "\n");

        Body = text;
        StateHasChanged();

        if (_caretModule is not null)
        {
            var caretAfter = (before.Length > 0 ? before.Length + 2 : 0) + reference.Length;
            await _caretModule.InvokeVoidAsync("focusAt", _sourceBox, caretAfter);
        }
    }

    private string Body
    {
        get => _body;
        set
        {
            if (value == _body || !CanEdit)
            {
                // readonly on the textarea is the visible half; this is the half that holds if a
                // value arrives anyway. The binding is the only route from a keystroke to the
                // store, so refusing here refuses the whole path.
                return;
            }

            _body = value;
            _savePending = true;
            Reconvert();
            _ = SaveSoon();
        }
    }

    // The shelf keeps its own subscription to the library — it is the only part of this page
    // that redraws when an upload lands or processing flips a file to Ready.
    protected override void OnInitialized() => Posts.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // file-drop.js only turns "files dropped on this element" into "the hidden InputFile
        // changed" — Blazor still owns the streaming. Both panes are targets: the source pane
        // because it is what an author is looking at while writing, the side pane because a
        // shelf you can see is a shelf you will aim at.
        if (CanEdit)
        {
            _dropModule = await Js.InvokeAsync<IJSObjectReference>("import", "./js/file-drop.js");
            await _dropModule.InvokeVoidAsync("init", _sourcePane);
            await _dropModule.InvokeVoidAsync("init", _sidePane);
            _caretModule = await Js.InvokeAsync<IJSObjectReference>("import", "./js/post-caret.js");
        }

        // The split is remembered across posts and sessions, so it is restored here rather than
        // rendered: the pane must not flash to half its width and then jump.
        _splitModule = await Js.InvokeAsync<IJSObjectReference>("import", "./js/post-split.js");
        await _splitModule.InvokeVoidAsync("init", _panes);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Guid.TryParseExact(PostIdValue, "N", out var guid) && !Guid.TryParse(PostIdValue, out guid))
        {
            Navigation.NavigateTo("/");
            return;
        }

        // Loaded into LOCALS, and published to the fields only once this component has committed
        // to showing the post. Assigning _post up front left every bail-out below holding a post
        // whose body had not been read yet — and that half-loaded pair is exactly what the flush
        // in DisposeAsync reads. A reviewer who is not a collaborator is bounced to "/" here, and
        // used to take the post's text with them on the way out.
        var id = PostId.From(guid);
        var post = await Store.LoadOrDefault<Post>(id.Stream);
        if (post is null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        // Site access is the wrong question for this page: the reviewer is mailed a link to ONE
        // post and is deliberately not a collaborator, so asking "may you touch this site" refused
        // the only person the mail was addressed to. PassForAsync answers per post instead.
        var pass = await Access.PassForAsync(post.SiteId, post.Review);
        if (pass is PostPass.None)
        {
            Navigation.NavigateTo("/");
            return;
        }

        var locale = Sites.Get(post.SiteId)?.DefaultLocale ?? new Locale("en");

        // Whether the signed-in user IS the reviewer decides which half of the workflow this
        // screen shows. With auth off (dev, tests, trusted LAN) there is nobody to be, and the
        // reviewing controls are the ones that appear — the same "open install" reading the rest
        // of the editor takes.
        var me = await Access.UserAsync();
        var isReviewer = Sites.Get(post.SiteId) is { ReviewerEmail: { Length: > 0 } reviewer }
            && (me is null || string.Equals(me, reviewer, StringComparison.OrdinalIgnoreCase));

        // Published together, with no await in between, so no interleaving can observe a post
        // that is loaded and a body that is not.
        _id = id;
        _pass = pass;
        _siteId = post.SiteId;
        _locale = locale;
        _isReviewer = isReviewer;
        _titleText = post.Title.Resolve(locale, locale);
        _slug = post.Slug.Value;
        _body = post.Body.Get(locale) ?? "";

        ApplyPost(post);
        Reconvert();
    }

    /// <summary>Pulls the review-and-schedule state off the aggregate and onto the screen.</summary>
    private void ApplyPost(Post post)
    {
        _post = post;
        _review = post.Review;
        _reviewNote = post.ReviewNote;
        _publishAt = post.PublishAt;
        _publishAtLocal = post.PublishAt is { } at
            ? EditorialTime.ToLocal(at).ToString("yyyy-MM-dd'T'HH:mm", System.Globalization.CultureInfo.InvariantCulture)
            : "";
        Refresh();
    }

    private void Reconvert()
    {
        var (roots, problems) = PostContent.Render(_body, _locale);
        _preview = roots;
        _problems = problems;
    }

    /// <summary>
    /// Saves the body after a pause in typing. A command per keystroke would put one event per
    /// character in the log — the history is meant to read like a person's edits, not a
    /// keylogger — and the preview is already live without it, so nothing is lost by waiting.
    /// </summary>
    private async Task SaveSoon()
    {
        var mine = ++_saveToken;
        await Task.Delay(SaveDebounce);
        if (mine != _saveToken)
        {
            return;   // superseded by a later keystroke
        }

        _savePending = false;
        await Commands.Run(new ChangePostBody(_id, _locale.Value, _body));
    }


    private const int SaveDebounce = 600;
    private int _saveToken;

    /// <summary>
    /// Whether the author has typed something the store has not been told about yet. It is set by
    /// the binding and cleared by whoever writes, which makes it the ONLY honest answer to "is
    /// there anything to save on the way out" — and the reason DisposeAsync no longer guesses by
    /// comparing strings. That comparison could not tell an author who emptied the body from a
    /// screen that never loaded one, and read the second as the first.
    /// </summary>
    private bool _savePending;

    /// <summary>
    /// Writes whatever the debounce is still holding, now. Every action that acts on the body —
    /// publishing it, sending it to a reviewer, or simply leaving the page — has to see the words
    /// on screen rather than the ones from a second ago.
    /// </summary>
    private Task FlushBody()
    {
        _saveToken++;   // cancel the pending timer; this save supersedes it
        if (!CanEdit)
        {
            _savePending = false;
            return Task.CompletedTask;
        }

        _savePending = false;
        return Commands.Run(new ChangePostBody(_id, _locale.Value, _body));
    }

    private async Task Publish()
    {
        if (!CanEdit)
        {
            return;
        }

        await FlushBody();
        await Commands.Run(new PublishPost(_id, _locale.Value));
        Refresh();
    }

    private async Task Unpublish()
    {
        if (!CanEdit)
        {
            return;
        }

        await Commands.Run(new UnpublishPost(_id));
        Refresh();
    }

    private void Refresh() =>
        _status = Posts.Get(_id)?.StatusAt(DateTimeOffset.UtcNow, Reviewer is not null) ?? PostStatus.Draft;

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    private static string Label(PostStatus status) => status switch
    {
        PostStatus.Published => "Published",
        PostStatus.Modified => "Unpublished changes",
        PostStatus.InReview => "In review",
        PostStatus.ChangesRequested => "Changes requested",
        PostStatus.Approved => "Approved",
        PostStatus.Scheduled => "Scheduled",
        _ => "Draft",
    };

    public void Dispose() => Posts.Changed -= OnChanged;

    // The JS modules need an async teardown of their own: a circuit that reconnects must not
    // leave the previous drop listeners bound to a detached element.
    public async ValueTask DisposeAsync()
    {
        Dispose();

        // The last sentence someone typed before navigating away is still sitting in the
        // debounce. Losing it is silent, which is the worst kind of losing — so the save is
        // flushed on the way out. Best effort by nature: the circuit may already be gone, and a
        // failure here must not stop the rest of the teardown.
        //
        // Gated on a save the AUTHOR caused, never on "the field differs from the aggregate".
        // Only a keystroke sets _savePending, so a screen that closed without one — bounced to
        // "/" for lack of access, or torn down mid-load — writes nothing at all. Leaving is not
        // an edit.
        try
        {
            if (_savePending)
            {
                await FlushBody();
            }
        }
        catch (Exception)
        {
            // Nothing left to save it with — the circuit or its scope is already disposing.
        }

        if (_dropModule is not null)
        {
            try
            {
                // Unbind both targets: the module object is shared per URL, so disposing the
                // reference alone would leave listeners on elements this circuit no longer owns.
                await _dropModule.InvokeVoidAsync("dispose", _sourcePane);
                await _dropModule.InvokeVoidAsync("dispose", _sidePane);
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; the elements went with it.
            }
        }

        if (_splitModule is not null)
        {
            try
            {
                await _splitModule.InvokeVoidAsync("dispose", _panes);
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; the element went with it.
            }
        }

        foreach (var module in new[] { _dropModule, _caretModule, _splitModule })
        {
            if (module is null)
            {
                continue;
            }

            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; there is nothing on the other side to release.
            }
        }
    }
}
