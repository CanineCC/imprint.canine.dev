@page "/site/{SiteIdValue}/posts"
@using Imprint.Authoring.Domain
@using Imprint.Authoring.Domain.Pages
@using Imprint.Authoring.Domain.Posts
@using Imprint.Authoring.Domain.Sites
@using Imprint.Authoring.Features.Posts.CreatePost
@using Imprint.Authoring.Features.Posts.SignPublishedPost
@using Imprint.Authoring.Features.Sites.SetPostOrder
@using Imprint.Authoring.Projections
@using Imprint.Editor.Auth
@using Imprint.Editor.Services
@implements IDisposable
@inject PostList Index
@inject SiteOverview Sites
@inject PageList Pages
@inject SiteAccess Access
@inject CommandRunner Commands
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>@Plural · Imprint</PageTitle>

<main class="dash">
    <Breadcrumbs Trail="@Trail" />
    <header class="dash-head">
        <h1>@Plural</h1>
        <p class="dash-sub">
            Written in markdown, published as static pages like everything else.
            Drafts are yours alone until you publish them.
        </p>
        @* Live articles nobody has signed (published before signatures, or copies of words approved
           elsewhere): the reviewer signs them all with their own login, in one go. *@
        @if (_isReviewer && Unsigned > 0)
        {
            <p class="post-sign-all">
                <button type="button" class="ed-btn ed-btn-primary" data-testid="posts-sign-all" @onclick="SignAll">
                    Sign all @Unsigned live @(Unsigned == 1 ? Singular.ToLowerInvariant() : Plural.ToLowerInvariant())
                </button>
                <span class="dash-sub">They are live without a signature. Signing records your login over the words that are live.</span>
            </p>
        }
    </header>

    <form class="post-new" @onsubmit="Create" @onsubmit:preventDefault>
        <label class="post-new-label" for="new-post-title">New @Singular.ToLowerInvariant()</label>
        <input id="new-post-title" class="ed-input" @bind="_title" @bind:event="oninput"
               placeholder="@($"{Singular} title")" data-testid="new-post-title" />
        @* A resource center lists and lays out articles by kind, so an article starts with one. *@
        @if (IsCenter)
        {
            <span class="post-new-kind">
                <label for="new-post-kind" class="ed-visually-hidden">Kind</label>
                <select id="new-post-kind" class="ed-input" data-testid="new-post-kind" @bind="_kind">
                    <option value="">Kind…</option>
                    <option value="essay">Essay</option>
                    <option value="guide">Guide</option>
                    <option value="whitepaper">Whitepaper</option>
                    <option value="documentation">Documentation</option>
                </select>
            </span>
        }
        <button type="submit" class="ed-btn ed-btn-primary"
                disabled="@(_title.Trim().Length == 0 || (IsCenter && _kind.Length == 0))"
                data-testid="new-post-create">Create</button>
    </form>

    @if (_posts.Count == 0)
    {
        <p class="dash-sub" data-testid="posts-empty">No @Plural.ToLowerInvariant() yet. The first one starts above.</p>
    }
    else
    {
        @* Two shelves: what is still to go out, in the order it should go, and what is live. The order is one list for
           the whole site (the plan); each tab shows its part of it. Drag a row, or use its arrows, to move it. *@
        <div class="post-tabs" role="tablist" aria-label="@Plural">
            <button type="button" role="tab" class="post-tab @(_tab == Tab.Unpublished ? "is-on" : null)"
                    aria-selected="@(_tab == Tab.Unpublished ? "true" : "false")" data-testid="posts-tab-unpublished"
                    @onclick="() => _tab = Tab.Unpublished">Unpublished <span>@Unpublished.Count</span></button>
            <button type="button" role="tab" class="post-tab @(_tab == Tab.Published ? "is-on" : null)"
                    aria-selected="@(_tab == Tab.Published ? "true" : "false")" data-testid="posts-tab-published"
                    @onclick="() => _tab = Tab.Published">Published <span>@Published.Count</span></button>
        </div>

        var shown = _tab == Tab.Published ? Published : Unpublished;
        @if (shown.Count == 0)
        {
            <p class="dash-sub">@(_tab == Tab.Published ? "Nothing is live yet." : "Everything is live.")</p>
        }
        else
        {
            <ol class="post-rows" aria-label="Posts" data-testid="post-list">
                @for (var i = 0; i < shown.Count; i++)
                {
                    var post = shown[i];
                    var index = i;
                    <li class="post-row @(_dragging == post.Id ? "is-dragging" : null) @(_over == post.Id ? "is-over" : null)"
                        draggable="true" data-testid="post-row" data-slug="@post.Slug.Value"
                        @ondragstart="() => _dragging = post.Id"
                        @ondragend="() => { _dragging = null; _over = null; }"
                        @ondragenter="() => _over = post.Id"
                        @ondragover:preventDefault="true"
                        @ondrop="() => Drop(post.Id)" @ondrop:preventDefault="true">
                        <span class="post-grip" aria-hidden="true">⠿</span>
                        <span class="post-rank">@(index + 1)</span>
                        <button type="button" class="dash-open post-row-open" data-testid="post-open"
                                data-slug="@post.Slug.Value" @onclick="() => Open(post.Id)">
                            <span class="dash-name">@Title(post)</span>
                            <span class="dash-meta">
                                <span class="post-status post-status-@post.Status.ToString().ToLowerInvariant()"
                                      data-testid="post-status">@Label(post.Status)</span>
                                @if (post.Hold is { } hold)
                                {
                                    <span class="post-held" title="@hold" data-testid="post-held">On hold</span>
                                }
                                @if (IsCenter && post.Kind is { } kind)
                                {
                                    <text> · @kind</text>
                                }
                                · /@post.Slug.Value
                                @if (post.PublishedAt is { } at)
                                {
                                    <text> · @at.UtcDateTime.ToString("yyyy-MM-dd")</text>
                                }
                            </span>
                            @if (post.Hold is { } why)
                            {
                                <span class="post-held-why">@why</span>
                            }
                        </button>
                        <span class="post-products" data-testid="post-products">
                            @foreach (var product in post.Products)
                            {
                                <span class="post-product post-product-@product">@ProductName(product)</span>
                            }
                        </span>
                        <span class="post-move">
                            <button type="button" class="ed-btn ed-btn-ghost" disabled="@(index == 0)" data-testid="post-up"
                                    aria-label="@($"Move {Title(post)} up")" @onclick="() => Move(shown, index, -1)">↑</button>
                            <button type="button" class="ed-btn ed-btn-ghost" disabled="@(index == shown.Count - 1)" data-testid="post-down"
                                    aria-label="@($"Move {Title(post)} down")" @onclick="() => Move(shown, index, +1)">↓</button>
                        </span>
                    </li>
                }
            </ol>
        }
    }
</main>

@code {
    [Parameter] public string SiteIdValue { get; set; } = "";

    private SiteId _site;

    // Sites / <blog> / Posts. Built here rather than in the component so the trail is the
    // page's own statement about where it sits, not a guess made from the URL.
    private IReadOnlyList<Breadcrumbs.Crumb> Trail =>
        Sites.Get(_site) is { } site
            ? [Breadcrumbs.Sites, Breadcrumbs.Of(site, Pages.HomeOf(site.Id)?.Id), new Breadcrumbs.Crumb("Posts")]
            : [Breadcrumbs.Sites, new Breadcrumbs.Crumb("Posts")];
    private string _title = "";
    private string _kind = "";

    private bool IsCenter => Sites.Get(_site)?.Kind == SiteKind.ResourceCenter;

    // A resource center holds articles; a blog holds posts. Labels only: the model keeps "post".
    private string Singular => IsCenter ? "Article" : "Post";

    private string Plural => IsCenter ? "Articles" : "Posts";
    private IReadOnlyList<PostSummary> _posts = [];

    // The order lives on the site, so a reorder (here or in another window) arrives as a site change.
    protected override void OnInitialized()
    {
        Index.Changed += OnChanged;
        Sites.Changed += OnChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Guid.TryParseExact(SiteIdValue, "N", out var guid) && !Guid.TryParse(SiteIdValue, out guid))
        {
            Navigation.NavigateTo("/");
            return;
        }

        _site = SiteId.From(guid);

        // A site id in a URL is guessable, so opening this list is an access check — the
        // same treatment the page editor gives an id of a site you may not touch.
        if (!await Access.CanAccessAsync(_site))
        {
            Navigation.NavigateTo("/");
            return;
        }

        // Signing is the reviewer's, as approving is (see PostEditor); with auth off there is nobody to be.
        var me = await Access.UserAsync();
        _isReviewer = Sites.Get(_site) is { ReviewerEmail: { Length: > 0 } reviewer }
            && (me is null || string.Equals(me, reviewer, StringComparison.OrdinalIgnoreCase));
        Reload();
    }

    /// <summary>
    /// The editorial queue: a plan's own order, not "most recently touched". A post numbered
    /// "(2)" answers the one numbered "(1)", and the projection's date ordering — right for the
    /// published index and the feed — scatters that completely. Posts with no number keep the
    /// projection's order, after the numbered ones.
    /// </summary>
    // The site's order first (the plan its editors set); a post not in it yet comes after, by its title's own
    // sequence number, as before there was an order.
    private void Reload()
    {
        var order = Sites.Get(_site)?.PostOrder ?? [];
        var rank = order.Select((id, i) => (id, i)).ToDictionary(x => x.id, x => x.i);
        _posts = [.. Index.All(_site)
            .OrderBy(post => rank.GetValueOrDefault(post.Id, int.MaxValue))
            .ThenBy(post => PostSequence.SortKey(Title(post)))];
    }

    private enum Tab { Unpublished, Published }

    private Tab _tab = Tab.Unpublished;
    private PostId? _dragging;
    private PostId? _over;

    // Live is live: a published post with edits not yet out (Modified) is still on the published shelf.
    private static bool IsLive(PostSummary post) => post.Status is PostStatus.Published or PostStatus.Modified;

    private IReadOnlyList<PostSummary> Unpublished => [.. _posts.Where(post => !IsLive(post))];

    private IReadOnlyList<PostSummary> Published => [.. _posts.Where(IsLive)];

    private static string ProductName(string product) => product switch
    {
        "cca" => "CCA",
        "cai" => "CAI",
        _ => char.ToUpperInvariant(product[0]) + product[1..],
    };

    private async Task Drop(PostId target)
    {
        var moving = _dragging;
        _dragging = null;
        _over = null;
        if (moving is { } id && id != target)
        {
            await Place(id, target);
        }
    }

    private async Task Move(IReadOnlyList<PostSummary> shown, int index, int step)
    {
        var to = index + step;
        if (to >= 0 && to < shown.Count)
        {
            await Place(shown[index].Id, shown[to].Id);
        }
    }

    // Moves a post to where another one stands in the whole order: after it when moving down, before it when moving
    // up, so a drop lands where the row was dropped and each arrow is one step.
    private async Task Place(PostId moving, PostId target)
    {
        var order = _posts.Select(post => post.Id).ToList();
        var from = order.IndexOf(moving);
        var at = order.IndexOf(target);
        if (from < 0 || at < 0)
        {
            return;
        }

        order.RemoveAt(from);
        order.Insert(order.IndexOf(target) + (from < at ? 1 : 0), moving);
        await Commands.Run(new SetPostOrder(_site, order));
    }

    private bool _isReviewer;

    private int Unsigned => _posts.Count(post => post.Status == PostStatus.Published && post.Signature is null);

    private async Task SignAll()
    {
        var count = Unsigned;
        if (await Commands.Run(new SignPublishedPosts(_site)))
        {
            Toasts.Show($"Signed {count} live {(count == 1 ? Singular.ToLowerInvariant() : Plural.ToLowerInvariant())}.");
        }
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        Reload();
        StateHasChanged();
    });

    private async Task Create()
    {
        var title = _title.Trim();
        if (title.Length == 0)
        {
            return;
        }

        var id = PostId.New();
        // Suggest() is the same slug derivation the page editor uses, so a title behaves the
        // way an author has already learned it does elsewhere in the product.
        var slug = UniqueSlug(Slug.Suggest(title));
        var locale = Sites.Get(_site)?.DefaultLocale.Value ?? "en";

        if (await Commands.Run(new CreatePost(id, _site, title, slug, locale, IsCenter ? _kind : null, IsCenter ? [] : null)))
        {
            _title = "";
            _kind = "";
            Navigation.NavigateTo($"/posts/{id.Compact}");
        }
    }

    /// <summary>
    /// Suffixes a duplicate title's slug rather than failing the create. Two posts called
    /// "Notes" is an ordinary thing to want, and an error message about slugs is not a useful
    /// answer to it — the author can still rename either one afterwards.
    /// </summary>
    private string UniqueSlug(string suggested)
    {
        if (!Slug.TryCreate(suggested, out var slug, out _))
        {
            return suggested;   // let the command's validator produce the real message
        }

        if (!Index.SlugTaken(_site, slug))
        {
            return slug.Value;
        }

        for (var n = 2; ; n++)
        {
            var candidate = $"{slug.Value}-{n}";
            if (Slug.TryCreate(candidate, out var next, out _) && !Index.SlugTaken(_site, next))
            {
                return candidate;
            }
        }
    }

    private void Open(PostId id) => Navigation.NavigateTo($"/posts/{id.Compact}");

    private string Title(PostSummary post)
    {
        var locale = Sites.Get(_site)?.DefaultLocale ?? new Locale("en");
        return post.Title.Resolve(locale, locale);
    }

    private static string Label(PostStatus status) => status switch
    {
        PostStatus.Published => "Published",
        PostStatus.Modified => "Unpublished changes",
        _ => "Draft",
    };

    public void Dispose()
    {
        Index.Changed -= OnChanged;
        Sites.Changed -= OnChanged;
    }
}
