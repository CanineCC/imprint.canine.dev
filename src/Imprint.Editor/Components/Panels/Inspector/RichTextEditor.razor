@inherits NodeEditorBase<RichTextNode>

<div class="ed-field">
    <label>Emphasis</label>
    <Segmented TValue="ProseEmphasis" Label="Paragraph emphasis" Value="Node.Emphasis"
               Options="EmphasisOptions" ValueChanged="SetEmphasis" />
    <p class="ed-insp-hint">
        @(Node.Emphasis switch
        {
            ProseEmphasis.Secondary => "A supporting paragraph — one step under the lede, and never shrunk to fine print.",
            ProseEmphasis.FinePrint => "The small closing line, asked for outright rather than because it comes last.",
            _ => "Set by the section. A paragraph that ends its section is treated as a small closing line.",
        })
    </p>
</div>

@* Text is edited where it lives — on the page. The inspector only points the way. *@
<p class="ed-insp-hint">
    Double-click the text on the page to edit it. Select some words while editing to
    make them bold or italic, add a link, or turn them into a list.
</p>

@code {
    private static readonly (string, ProseEmphasis)[] EmphasisOptions =
    [
        ("Default", ProseEmphasis.Default),
        ("Secondary", ProseEmphasis.Secondary),
        ("Fine print", ProseEmphasis.FinePrint),
    ];

    private Task SetEmphasis(ProseEmphasis emphasis) =>
        Apply(Node with { Emphasis = emphasis }, "paragraph emphasis");
}
