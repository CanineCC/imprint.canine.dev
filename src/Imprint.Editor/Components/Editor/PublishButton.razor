@using Imprint.Authoring.Projections
@using Imprint.Authoring.Domain.Posts
@using Imprint.Authoring.Domain.Schedules
@using Imprint.Editor.Services
@implements IDisposable
@inject EditorSession Session
@inject PageList Pages
@inject ScheduledPages Schedules
@inject CommandRunner Commands
@inject ToastService Toasts

@* Publish is a domain decision; file generation follows eventually (the publisher is
   a projection). The split button covers "this page" and "everything stale". *@
@if (Session.CurrentPageId is { } pageId && Pages.Get(pageId) is { } current && Session.ActiveSiteId is { } siteId)
{
    var stale = Pages.All(siteId).Count(p => p.Status != PageStatus.Published);
    <div class="ed-publish">
        <button type="button"
                class="ed-btn ed-btn-primary"
                disabled="@(current.Status == PageStatus.Published || _busy)"
                @onclick="PublishCurrent">
            @(current.Status switch
            {
                PageStatus.Draft => "Publish",
                PageStatus.Modified => "Publish changes",
                _ => "Published",
            })
        </button>
        @if (stale > 1)
        {
            <button type="button" class="ed-btn" disabled="@_busy" @onclick="() => PublishAll(siteId)">
                Publish all (@stale)
            </button>
        }
        <span class="ed-badge @(current.Status == PageStatus.Published ? "ed-badge-ok" : "ed-badge-warn")">
            @current.Status
        </span>

        @* Scheduling: the page goes live at a wall-clock time in the editorial zone, as it stands then. *@
        @{ var schedule = Schedules.Get(pageId); }
        @if (schedule is { State: PageScheduleState.Pending })
        {
            <span class="ed-badge ed-badge-accent" data-testid="page-scheduled">
                Scheduled @EditorialTime.ForAuthor(schedule.At)
            </span>
            <button type="button" class="ed-btn ed-btn-ghost" data-testid="page-schedule-cancel" disabled="@_busy"
                    @onclick="() => SetSchedule(pageId, null)">Cancel schedule</button>
        }
        else if (_choosing)
        {
            <label class="ed-publish-when">
                <span class="ed-visually-hidden">Publish at (@EditorialTime.Zone.Id)</span>
                <input type="datetime-local" class="ed-input" data-testid="page-schedule-at"
                       title="@($"Wall-clock time in {EditorialTime.Zone.Id}")" @bind="_whenLocal" />
            </label>
            <button type="button" class="ed-btn" data-testid="page-schedule-confirm"
                    disabled="@(_busy || _whenLocal is null)" @onclick="() => Confirm(pageId)">Schedule</button>
            <button type="button" class="ed-btn ed-btn-ghost" @onclick="() => _choosing = false">Cancel</button>
        }
        else
        {
            <button type="button" class="ed-btn" data-testid="page-schedule" disabled="@_busy"
                    @onclick="() => _choosing = true">Schedule…</button>
        }

        @if (schedule is { State: PageScheduleState.Failed })
        {
            <span class="ed-badge ed-badge-warn" data-testid="page-schedule-failed" title="@schedule.FailureReason">
                Scheduled publish failed
            </span>
        }
    </div>
}

@code {
    private bool _busy;
    private bool _choosing;
    private DateTime? _whenLocal;

    private async Task Confirm(Authoring.Domain.PageId pageId)
    {
        if (_whenLocal is not { } local)
        {
            return;
        }

        await SetSchedule(pageId, EditorialTime.FromLocal(local));
        _choosing = false;
    }

    private async Task SetSchedule(Authoring.Domain.PageId pageId, DateTimeOffset? at)
    {
        _busy = true;
        if (await Commands.Run(new Authoring.Features.Schedules.SchedulePagePublish(pageId, at)))
        {
            Toasts.Show(at is { } when
                ? $"Scheduled for {EditorialTime.ForAuthor(when)} ({EditorialTime.Zone.Id})."
                : "Schedule cancelled.");
        }

        _busy = false;
    }

    private async Task PublishCurrent()
    {
        if (Session.CurrentPageId is not { } pageId)
        {
            return;
        }

        _busy = true;
        if (await Commands.Run(new Authoring.Features.Pages.PublishPage.PublishPage(pageId)))
        {
            Toasts.Show("Published — the static site is updating.");
        }

        _busy = false;
    }

    private async Task PublishAll(Authoring.Domain.SiteId siteId)
    {
        _busy = true;
        if (await Commands.Run(new Authoring.Features.Pages.PublishAllStale.PublishAllStale(siteId)))
        {
            Toasts.Show("All pages published.");
        }

        _busy = false;
    }

    protected override void OnInitialized()
    {
        Pages.Changed += Refresh;
        Schedules.Changed += Refresh;
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Pages.Changed -= Refresh;
        Schedules.Changed -= Refresh;
    }
}
